# ===========================================
# YouTube Clear View - Development Configuration
# ===========================================

# Flask Configuration
FLASK_SECRET_KEY=replace_with_generated_secret
FLASK_PORT=5550
FLASK_HOST=0.0.0.0
FLASK_DEBUG=true
PROD=false
COOKIE_SECURE=false
AUTH_MODE=google
LOCAL_SIGNUP_ENABLED=false
AUTH_TOKEN_ENCRYPTION_KEY=replace_with_generated_fernet_key
PASSWORD_POLICY=strong
FRONTEND_URL=http://localhost:8080
PASSKEY_RP_NAME=YT Clear View
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:8080
PASSKEY_ALLOWED_ORIGINS=http://localhost:8080

# Database
DATABASE_URI=sqlite:///yt_clear_view.db

# YouTube API
YT_API_KEY=replace_with_google_api_key
YT_DAILY_QUOTA=10000
YT_QUOTA_CAP_RATIO=1.0
YT_REFRESH_COST=2
YT_RSS_COMPLETION_COST=1
VIDEO_REFRESH_MODE=hybrid
MANUAL_REFRESH_RESERVED_QUOTA_RATIO=0.1
MANUAL_REFRESH_FULL_COOLDOWN_SECONDS=7200
MANUAL_REFRESH_CHANNEL_COOLDOWN_SECONDS=1800

# Google Device Flow (PRIMARY)
GOOGLE_DEVICE_CLIENT_ID=replace_with_google_device_client_id
GOOGLE_DEVICE_CLIENT_SECRET=replace_with_google_device_client_secret
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/youtube.readonly

# Google OAuth web callback (compatibility with current backend validation/bootstrap)
# Keep these aligned with the same Google project used for Device Flow.
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5550/api/auth/google/callback

# CORS
CORS_ORIGINS=http://localhost:8080,http://localhost:5550

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
APP_TIMEZONE=Europe/Madrid
ADMIN_USERNAMES=
SQLITE_METRICS_ENABLED=false
SQLITE_METRICS_SLOW_WRITE_MS=100

# Cache
CACHE_TTL=3600

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
BACKFILL_INTERVAL_MINUTES=15
BACKFILL_MAX_CHANNELS=50
