# ===========================================
# YT Clear View - Configuration
# ===========================================

# Flask Configuration
FLASK_SECRET_KEY=your-super-secret-key-here
FLASK_PORT=5550
FLASK_HOST=0.0.0.0
FLASK_DEBUG=False
PROD=false
COOKIE_SECURE=True
AUTH_MODE=local
AUTH_TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=https://ytcv.mi-nas.me
PASSKEY_RP_NAME=YT Clear View
PASSKEY_RP_ID=ytcv.mi-nas.me
PASSKEY_ORIGIN=https://ytcv.mi-nas.me
PASSKEY_ALLOWED_ORIGINS=https://ytcv.mi-nas.me
# Local LAN example:
# FRONTEND_URL=http://192.168.1.50:8080

# Database
DATABASE_URI=sqlite:///yt_clear_view.db

# YT API
YT_API_KEY=your-google-cloud-console-api-key
YT_DAILY_QUOTA=10000
YT_QUOTA_CAP_RATIO=0.8
YT_REFRESH_COST=2
MANUAL_REFRESH_FULL_COOLDOWN_SECONDS=7200
MANUAL_REFRESH_CHANNEL_COOLDOWN_SECONDS=1800

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://apiyt.mi-nas.me/api/auth/google/callback
# Note:
# Google OAuth web apps should use localhost in local development or a real HTTPS hostname.
# Raw private IP redirect URIs are not a reliable option for Google OAuth.
# Optional: override default scopes (must include youtube.readonly for subscriptions)
GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/youtube.readonly"
# Optional but recommended:
# 32-byte Fernet key for encrypting stored Google tokens at rest.
# If omitted, the app derives a stable key from FLASK_SECRET_KEY.
# Generate with:
# python3 - <<'PY'
# from cryptography.fernet import Fernet
# print(Fernet.generate_key().decode())
# PY

# CORS - IMPORTANT: Frontend is served via reverse proxy
# All connections are HTTPS
CORS_ORIGINS=https://ytcv.mi-nas.me,https://apiyt.mi-nas.me
# Local LAN example:
# CORS_ORIGINS=http://192.168.1.50:8080,http://192.168.1.50:5550

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
ADMIN_USERNAMES=
SQLITE_METRICS_ENABLED=false
SQLITE_METRICS_SLOW_WRITE_MS=100

# Log Viewer (separate service)
LOG_VIEWER_USER=admin
LOG_VIEWER_PASSWORD=your-secure-log-password
LOG_VIEWER_PORT=5551

# Cache
CACHE_TTL=3600

# Scheduler (auto refresh)
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
BACKFILL_INTERVAL_MINUTES=15
BACKFILL_MAX_CHANNELS=50

# Classification (optional - for Ollama LLM classifier)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:mini
CLASSIFICATION_METHOD=auto
